# Postgres connection string (currently Aiven - see src/db/client.ts for why this has
# moved providers twice; any standard Postgres wire-protocol connection string works).
# Required unless DB_DRIVER=pglite is explicitly set below - there is no silent
# fallback. Missing both throws immediately rather than guessing.
DATABASE_URL=

# Set to exactly "pglite" to explicitly opt into the local embedded PGlite DB
# (.pglite-data/) instead of DATABASE_URL. Never set this in production - it
# exists so local dev without a provisioned Postgres fails loudly if forgotten,
# not so it can be left on by accident.
DB_DRIVER=

# Vercel Blob read/write token, for storing gzipped CSV snapshots forever.
# Without this, snapshots fall back to a local .snapshots/ directory - fine for dev, never for production.
BLOB_READ_WRITE_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls /api/sync/trigger on schedule. Also required for a manual trigger.
CRON_SECRET=

# Optional: POSTed with { alerts, checkedAt } when checkAlerts() finds something
# (source stale 7+ days, row-count swing >2%, two consecutive sync failures).
ALERT_WEBHOOK_URL=

# Companies House public data API key (free): https://developer.company-information.service.gov.uk/
# Without this, /api/companies-house/process returns a safe 500 rather than attempting lookups.
COMPANIES_HOUSE_API_KEY=
